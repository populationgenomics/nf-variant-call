manifest {
    name = 'nf-variant-call'
    description = 'CRAM -> single-sample reblocked gVCF with GATK HaplotypeCaller, plus gVCF QC, driven by Metamist cohorts or sequencing groups'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04'
}

// the defaults. main.nf's params block declares their types
params {
    // what to genotype: exactly one of cohorts or sgids, from which the run builds its sample sheet in Metamist
    dataset               = null  // the analysis dataset: launches and pays for the run, and holds its run records
    sequencing_type       = null  // genome | exome
    accessLevel           = null  // full | standard, or test: <dataset>-test project and bucket
    arGuid                = null  // supplied from analysis-runner, used in billing labels
    cohorts               = null  // COH1,COH2 on the command line, or a list in a config file
    sgids                 = null  // CPG1,CPG2 on the command line, or a list in a config file. Queried directly, not via cohorts

    // null: each SG's outputs go to its dataset's bucket. Set for local runs: <output_root>/<dataset>/ instead
    output_root           = null

    register              = true  // if false, no metamist registrations
    qc_genotyped          = false // if true, also run gVCF QC on genotyped SGs whose gVCF has no gvcf_qc analysis
    register_wait_minutes = 30    // permitted time (mins) for async output write to destination, prior to registration
    genotyping_intervals  = 0     // genotyping intervals per SG. 0: genome 30, exome 1
    downsample_reads      = 20    // HaplotypeCaller's --max-reads-per-alignment-start, genomes only
    pairhmm_threads       = 4     // HaplotypeCaller's --native-pair-hmm-threads
    reblock_gq_bands      = [13, 20, 30, 40] // ReblockGVCF's -GQB bands

    // the reference of a CRAM whose cram analysis doesn't record one: the DRAGEN-masked FASTA of the CRAMs made
    // before nf-align. Expects <name>.dict and .fai alongside
    aligned_ref_fasta     = "gs://cpg-common-main/references/hg38/v0/dragen_reference/Homo_sapiens_assembly38_masked.fasta"
    // the reference of a gVCF whose gvcf analysis doesn't record one (every gVCF cpg-flow made): the same
    // DRAGEN-masked FASTA. Only read for QC-only SGs. Expects <name>.dict and .fai alongside
    genotyped_ref_fasta   = "gs://cpg-common-main/references/hg38/v0/dragen_reference/Homo_sapiens_assembly38_masked.fasta"

    // the regions genotyped, as in cpg-flow-align-genotype's config_template.toml, minus calling_exclusions
    calling_regions_genome = "gs://cpg-common-test/rd_references/intervals/wgs_calling_regions.hg38.interval_list"
    calling_regions_exome  = "gs://cpg-common-main/references/hg38/v0/exome_calling_regions.v1.interval_list"
    calling_exclusions     = "gs://cpg-common-test/rd_references/intervals/hg38.telomeres_centromeres_and_hard_calling_exclusions.interval_list"
    // the primary contigs plus chrM: records outside it are dropped from the final gVCF
    noalt_bed              = "gs://cpg-common-main/references/hg38/v0/sv-resources/resources/v1/primary_contigs_plus_mito.bed.gz"

    // gVCF QC. dbSNP with its .idx alongside, for CollectVariantCallingMetrics
    dbsnp_vcf              = "gs://cpg-common-main/references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf"
    // the evaluation regions, stored as BED so they aren't tied to one reference's .dict: each is turned into an
    // interval list headed with the gVCF's own reference .dict, as in nf-align's Picard QC
    genome_evaluation_regions = "gs://cpg-common-test/rd_references/intervals/wgs_evaluation_regions.hg38.bed"
    exome_evaluation_regions  = "gs://cpg-common-test/rd_references/intervals/exome_evaluation_regions.v1.bed"

    // GATK, bcftools and tabix: cpg-flow's genotyping image
    gatk_container        = "australia-southeast1-docker.pkg.dev/cpg-common/images/gatk:4.6.2.0-2"
    // picard, as nf-align's CRAM QC uses
    picard_container      = "australia-southeast1-docker.pkg.dev/cpg-common/images-dev/picard:3.5.0-3"
    // metamist and cpg_utils, for the sample sheet and registration
    cpg_container         = "australia-southeast1-docker.pkg.dev/cpg-common/images/nf_base:5.8.1-1"
}

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until we have profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        google.batch.spot = true
        google.batch.maxSpotAttempts = 3
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.accessLevel = 'standard'
        // never pulled: the local executor runs without docker
        params.gatk_container = 'stub'
        params.picard_container = 'stub'
        params.cpg_container = 'stub'
        params.register = false
        params.output_root = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
